#!/usr/bin/env bash
set -euo pipefail
umask 077

root="$(cd "$(dirname "$0")/.." && pwd)"
runtime="${HARBORIST_DEPLOY_RUNTIME:-rust}"
case "$runtime" in
    rust)
        default_state="$HOME/.local/share/harborist-rust-deployment"
        default_project=harborist-rust
        compose_file=compose.rust.yaml
        cli=(harborist)
        ;;
    python)
        default_state="$HOME/.local/share/harborist-deployment"
        default_project=harborist
        compose_file=compose.yaml
        cli=(python -m harborist)
        ;;
    *) echo "HARBORIST_DEPLOY_RUNTIME must be rust or python." >&2; exit 2 ;;
esac
export HARBORIST_DEPLOY_STATE="${HARBORIST_DEPLOY_STATE:-$default_state}"
export HARBORIST_SANDBOX_PORT="${HARBORIST_SANDBOX_PORT:-19454}"
project="${HARBORIST_DEPLOY_PROJECT:-$default_project}"
label="local.harborist.sandbox.$project"
domain="gui/$UID"
compose=(docker compose --project-name "$project" -f "$root/$compose_file" -f "$root/deploy/compose.sandbox.yaml")

case "${1:-start}" in
    stop|remove)
        "${compose[@]}" down
        if launchctl print "$domain/$label" >/dev/null 2>&1; then
            launchctl bootout "$domain/$label"
        fi
        exit
        ;;
    exec)
        shift
        exec "${compose[@]}" exec -T service "${cli[@]}" "$@"
        ;;
    start) ;;
    *) echo "Usage: deploy/harborist [start|stop|remove|exec ARGS...]" >&2; exit 2 ;;
esac

if [[ "$(uname -s)" != Darwin || "$(uname -m)" != arm64 || "$(sysctl -n kern.hv_support)" != 1 ]]; then
    echo "Harborist deployment requires Apple silicon macOS with hardware virtualization." >&2
    exit 1
fi
docker info >/dev/null
docker compose version >/dev/null
sbx="$(command -v sbx)" || { echo "Install Docker Sandboxes 0.54.x with Homebrew." >&2; exit 1; }
if ! "$sbx" version | grep -Eq '(^|[[:space:]])v0\.54\.[0-9]+([[:space:]]|$)'; then
    echo "Harborist requires Docker Sandboxes 0.54.x." >&2
    exit 1
fi
if ! "$sbx" --no-input policy ls --json >/dev/null; then
    echo "Sign in with sbx login and initialize the host sandbox network policy." >&2
    exit 1
fi

mkdir -p "$HARBORIST_DEPLOY_STATE"
HARBORIST_DEPLOY_STATE="$(cd "$HARBORIST_DEPLOY_STATE" && pwd)"
chmod 700 "$HARBORIST_DEPLOY_STATE"
if [[ "$runtime" == rust ]]; then
    helper="${HARBORIST_RUST_HELPER:-}"
    if [[ -z "$helper" ]]; then
        command -v cargo >/dev/null || { echo "Install Cargo or set HARBORIST_RUST_HELPER to a native Harborist binary." >&2; exit 1; }
        cargo build --manifest-path "$root/experiments/rust-verification/Cargo.toml" \
            --target-dir "$HARBORIST_DEPLOY_STATE/build" --locked --release
        helper="$HARBORIST_DEPLOY_STATE/build/release/harborist-verify"
    fi
    if [[ "$helper" != /* || ! -x "$helper" ]]; then
        echo "HARBORIST_RUST_HELPER must be an absolute path to an executable native binary." >&2
        exit 1
    fi
    token="$HARBORIST_DEPLOY_STATE/token"
    if [[ ! -e "$token" ]]; then
        (set -o noclobber; openssl rand -hex 32 >"$token")
    fi
    chmod 444 "$token"
    plist="$(mktemp "$HARBORIST_DEPLOY_STATE/helper.XXXXXX")"
    plutil -create xml1 "$plist"
    plutil -insert Label -string "$label" "$plist"
    plutil -insert ProgramArguments -array "$plist"
    arguments=("$helper" sandbox-host "$HARBORIST_DEPLOY_STATE" "$HARBORIST_SANDBOX_PORT" --sbx "$sbx")
    for index in "${!arguments[@]}"; do
        plutil -insert "ProgramArguments.$index" -string "${arguments[$index]}" "$plist"
    done
    plutil -insert KeepAlive -bool YES "$plist"
    plutil -insert StandardOutPath -string "$HARBORIST_DEPLOY_STATE/helper.log" "$plist"
    plutil -insert StandardErrorPath -string "$HARBORIST_DEPLOY_STATE/helper.log" "$plist"
    plutil -lint "$plist" >/dev/null
    mv "$plist" "$HARBORIST_DEPLOY_STATE/helper.plist"
else
command -v uv >/dev/null || { echo "Install uv to prepare the host helper." >&2; exit 1; }
export UV_PROJECT_ENVIRONMENT="$HARBORIST_DEPLOY_STATE/venv"
uv sync --project "$root" --locked --no-dev

python="$UV_PROJECT_ENVIRONMENT/bin/python"
"$python" - "$label" "$sbx" <<'PY'
import os
import plistlib
import secrets
import sys
from pathlib import Path

label, sbx = sys.argv[1:]
directory = Path(os.environ["HARBORIST_DEPLOY_STATE"])
token = directory / "token"
try:
    with token.open("x") as stream:
        stream.write(secrets.token_hex(32))
except FileExistsError:
    pass
token.chmod(0o444)  # Docker bind mount crosses user IDs. The host directory is private.
log = str(directory / "helper.log")
(directory / "helper.plist").write_bytes(plistlib.dumps({
    "Label": label,
    "ProgramArguments": [
        sys.executable, "-m", "harborist.sandbox.host_server",
        str(directory), os.environ["HARBORIST_SANDBOX_PORT"], "--sbx", sbx,
    ],
    "KeepAlive": True,
    "StandardOutPath": log,
    "StandardErrorPath": log,
}))
PY
fi


# Keep the host principal and token stable when updating the stack.
if launchctl print "$domain/$label" >/dev/null 2>&1; then
    "${compose[@]}" stop
    launchctl bootout "$domain/$label"
fi
# launchd can finish unloading a job after bootout returns.
for attempt in {1..20}; do
    if launchctl bootstrap "$domain" "$HARBORIST_DEPLOY_STATE/helper.plist" 2>"$HARBORIST_DEPLOY_STATE/bootstrap.log"; then
        break
    fi
    if [[ "$attempt" == 20 ]]; then
        cat "$HARBORIST_DEPLOY_STATE/bootstrap.log" >&2
        exit 1
    fi
    sleep 0.25
done
"${compose[@]}" up --build --wait
if [[ "$runtime" == rust ]]; then
    sandbox_check=(harborist-verify sandbox-check)
else
    sandbox_check=(python -c 'from harborist.sandbox.docker import DockerSandboxRuntime; print(DockerSandboxRuntime().baseline_digest())')
fi
if ! "${compose[@]}" exec -T service "${sandbox_check[@]}" >/dev/null; then
    echo "The deployed worker could not reach an initialized Docker Sandboxes helper." >&2
    exit 1
fi
echo "Harborist is ready at http://127.0.0.1:${HARBORIST_WEB_PORT:-8765}."
echo "If needed, configure Codex on the host with sbx secret set openai --oauth."
